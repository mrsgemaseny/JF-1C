    "build:github": "cross-env BUILD_TARGET=github tsc && cross-env BUILD_TARGET=github vite build",
    "preview": "vite preview",
    "deploy": "cross-env VITE_API_URL=https://zhanfinance.fly.dev VITE_GOOGLE_CLIENT_ID=249161344734-j51fft6shbogf2clnrhofn3l0c1euihl.apps.googleusercontent.com vite build && node -e \"require('fs').copyFileSync('dist/index.html', 'dist/404.html')\" && gh-pages -d dist",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "codegen:api": "openapi-typescript http://localhost:8080/api/v3/api-docs -o src/shared/api/generated-schema.d.ts"
